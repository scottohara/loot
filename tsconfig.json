{
	"compilerOptions": {
		// Type Checking
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"strictFunctionTypes": false,

		// Modules
		"module": "esnext",
		"paths": {
			"~/*": ["./src/*"]
		},
		"types": ["angular-mocks", "angular-ui-router", "node"],

		// Emit
		"sourceMap": true,

		// JavaScript Support

		// Editor Support

		// Interop Constraints
		"verbatimModuleSyntax": true,

		// Backwards Compatibility

		// Language and Environment
		"lib": ["DOM", "ES2025", "WebWorker"],

		// Compiler Diagnostics

		// Projects
		"incremental": true

		// Output Formatting

		// Completeness

		// Command Line

		// Watch Options
	},
	"exclude": ["cypress", "node_modules"]
}
